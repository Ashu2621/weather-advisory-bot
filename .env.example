GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Required to read GET /audit (Authorization: Bearer ... or X-Audit-Token). Unset = closed.
AUDIT_TOKEN=local-dev

# --- scaling out (both optional; unset = single process on SQLite) ---
# DATABASE_URL=postgresql://user:pass@host:5432/advisory   # session memory + audit
# REDIS_URL=redis://localhost:6379/0                        # rate limit + daily budget

# --- limits ---
# CHAT_BURST=5
# CHAT_PER_MINUTE=10
# MODEL_DAILY_CALL_BUDGET=0          # model calls per UTC day, 0 = no budget
# MODEL_TIMEOUT_MS=20000
# MODEL_RETRY_BUDGET_SECONDS=20
# METRICS_TOKEN=                     # set to require a bearer token on /metrics

# --- load tests / compose stack only ---
# MODEL_PROVIDER=fake
# FAKE_MODEL_LATENCY_MS=300
# WEATHER_FIXTURE=evals/fixtures/heavy_rain_derived.json
